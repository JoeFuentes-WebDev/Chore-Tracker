# Copy to .env.local and fill in real values. Do not commit .env.local.

# Neon (Postgres) connection string — required for `db:migrate` and `db:seed`
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Clerk — parent authentication (V2-M2)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/auth/parent/continue
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/auth/parent/continue

# App origin for invite links (V2-M4)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push (V2-M8) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:parent@example.com

# Twilio SMS credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=   # E.164 format, e.g. +14155551234
