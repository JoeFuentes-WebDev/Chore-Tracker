// ChoreTracker — Prisma schema (M1)
// Target: Neon (Postgres). One family per deployment (TD-05).
// Single Chore entity with lifecycle status (TD-15).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ChoreStatus {
  AVAILABLE
  CLAIMED
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
}

enum ChoreCreator {
  PARENT
  CHILD
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  COUNTERED
  REJECTED
}

enum NotificationStatus {
  SENT
  FAILED
}

enum NotificationEvent {
  CHORE_CLAIMED
  CHORE_UNCLAIMED
  CHORE_COMPLETED
  PROPOSAL_SUBMITTED
  PIN_RESET
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Single household record per deployment (TD-05).
model Family {
  id          String   @id @default("singleton")
  parentPhone String? // E.164; set during bootstrap (M2)
  pinHash     String? // bcrypt hash; null = bootstrap mode (TD-04)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  children Child[]
}

model Child {
  id        String   @id @default(cuid())
  name      String
  familyId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  chores    Chore[]
  proposals Proposal[]

  @@index([familyId])
}

model Chore {
  id               String       @id @default(cuid())
  name             String
  description      String?
  reward           Decimal      @db.Decimal(10, 2)
  status           ChoreStatus
  childId          String? // null = Available (unassigned)
  rejectionComment String?
  createdBy        ChoreCreator
  paid             Boolean      @default(false) // TD-13; meaningful when APPROVED
  sourceProposalId String?      @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  child            Child?            @relation(fields: [childId], references: [id], onDelete: SetNull)
  sourceProposal   Proposal?         @relation(fields: [sourceProposalId], references: [id], onDelete: SetNull)
  notificationLogs NotificationLog[]

  @@index([status])
  @@index([childId])
}

model Proposal {
  id             String         @id @default(cuid())
  name           String
  askingReward   Decimal        @db.Decimal(10, 2)
  counterReward  Decimal?       @db.Decimal(10, 2)
  status         ProposalStatus @default(PENDING)
  childId        String
  acknowledgedAt DateTime? // TD-12: child ack after rejection
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  child        Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdChore Chore?

  @@index([status])
  @@index([childId])
}

/// SMS audit trail. State transitions are never blocked if SMS fails.
model NotificationLog {
  id        String             @id @default(cuid())
  choreId   String? // null for PIN_RESET events
  event     NotificationEvent
  phone     String
  message   String
  status    NotificationStatus
  twilioSid String?
  error     String?
  createdAt DateTime           @default(now())

  chore Chore? @relation(fields: [choreId], references: [id], onDelete: SetNull)

  @@index([choreId])
  @@index([createdAt])
}
