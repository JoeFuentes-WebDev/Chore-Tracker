generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Family {
  id          String             @id @default(cuid())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  name        String
  children    Child[]
  chores      Chore[]
  memberships FamilyMembership[]
  invitations Invitation[]
  proposals   Proposal[]
}

model User {
  id             String            @id @default(cuid())
  slug           String            @unique
  name           String
  email          String?           @unique
  phone          String?
  pinHash        String?
  role           UserRole
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  clerkUserId    String?           @unique
  assignedChores Chore[]           @relation("ChoreAssignee")
  membership     FamilyMembership?
  proposals      Proposal[]        @relation("ProposalAuthor")
  invitations    Invitation[]      @relation("RecoveryInvitations")
}

model FamilyMembership {
  id        String   @id @default(cuid())
  familyId  String
  userId    String   @unique
  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model Invitation {
  id         String    @id @default(cuid())
  familyId   String
  userId     String?
  token      String    @unique
  role       UserRole
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  family     Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user       User?     @relation("RecoveryInvitations", fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
}

/// @deprecated Retained for migration rollback (TD-V2-06). App code uses User.
model Child {
  id        String     @id @default(cuid())
  name      String
  familyId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  chores    Chore[]    @relation("LegacyChildChores")
  proposals Proposal[] @relation("LegacyChildProposals")

  @@index([familyId])
}

model Chore {
  id               String            @id @default(cuid())
  name             String
  description      String?
  reward           Decimal           @db.Decimal(10, 2)
  status           ChoreStatus
  /// Legacy assignee FK — kept in sync with assignedUserId (TD-V2-07).
  childId          String?
  rejectionComment String?
  createdBy        ChoreCreator
  paid             Boolean           @default(false)
  sourceProposalId String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  familyId         String
  assignedUserId   String?
  assignee         User?             @relation("ChoreAssignee", fields: [assignedUserId], references: [id])
  child            Child?            @relation("LegacyChildChores", fields: [childId], references: [id])
  family           Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  sourceProposal   Proposal?         @relation(fields: [sourceProposalId], references: [id])
  notificationLogs NotificationLog[]

  @@index([status])
  @@index([familyId])
  @@index([childId])
  @@index([assignedUserId])
}

model Proposal {
  id               String         @id @default(cuid())
  name             String
  askingReward     Decimal        @db.Decimal(10, 2)
  counterReward    Decimal?       @db.Decimal(10, 2)
  status           ProposalStatus @default(PENDING)
  /// Legacy author FK — kept in sync with proposedByUserId (TD-V2-07).
  childId          String
  acknowledgedAt   DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  familyId         String
  proposedByUserId String
  createdChore     Chore?
  child            Child          @relation("LegacyChildProposals", fields: [childId], references: [id], onDelete: Cascade)
  family           Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author           User           @relation("ProposalAuthor", fields: [proposedByUserId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([familyId])
  @@index([childId])
  @@index([proposedByUserId])
}

model NotificationLog {
  id        String             @id @default(cuid())
  choreId   String?
  event     NotificationEvent
  phone     String
  message   String
  status    NotificationStatus
  twilioSid String?
  error     String?
  createdAt DateTime           @default(now())
  chore     Chore?             @relation(fields: [choreId], references: [id])

  @@index([choreId])
  @@index([createdAt])
}

enum UserRole {
  PARENT
  CHILD
}

enum ChoreStatus {
  AVAILABLE
  CLAIMED
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
}

enum ChoreCreator {
  PARENT
  CHILD
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  COUNTERED
  REJECTED
}

enum NotificationStatus {
  SENT
  FAILED
}

enum NotificationEvent {
  CHORE_CLAIMED
  CHORE_UNCLAIMED
  CHORE_COMPLETED
  PROPOSAL_SUBMITTED
  PIN_RESET
}
